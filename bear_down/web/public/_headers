# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# dx bundle copies public/ into dist/public, the Pages build output.
# connect-src allows the telemetry Worker that fan votes go to
# (src/feedback.rs, TELEMETRY_URL; a test keeps the two in step) and
# Cloudflare Web Analytics, which Pages injects (infra web_apps()).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; connect-src 'self' https://jimhillr-telemetry.jim-hill-r.workers.dev https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
