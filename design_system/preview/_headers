# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# `mise run release` copies this file into dist/ with the site.
# The page loads only its own files: theme.js as a file, never inline (a
# test in src/main.rs checks), and inline <style> for the tokens.
# Cloudflare Web Analytics, which Pages injects, is the one other origin.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
