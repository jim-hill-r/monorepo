{
  "name": "web",
  "version": "0.1.0",
  "description": "Playwright tests for Cookbook web application",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "bundle": "dx bundle --package web --platform web",
    "bundle:release": "dx bundle --package web --platform web --release"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
