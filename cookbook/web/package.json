{
  "name": "cookbook-web-tests",
  "version": "0.1.0",
  "description": "Playwright tests for Cookbook web application",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "bundle": "dx bundle --package web --platform web",
    "bundle:release": "dx bundle --package web --platform web --release"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
