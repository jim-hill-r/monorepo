# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# dx bundle copies public/ into dist/public, the Pages build output.
# The CSP is the <meta> CSP in src/main.rs plus frame-ancestors, which a
# <meta> CSP can't set; tests in src/main.rs keep the two in step.
# The PostHog hosts are for session replay, which public/posthog.js loads on
# the production host only (decision 0001).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://us-assets.i.posthog.com https://static.cloudflareinsights.com; connect-src 'self' https://dev-jdadpn4pckxevrv5.us.auth0.com https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com; img-src 'self'; style-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
